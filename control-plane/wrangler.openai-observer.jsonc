{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-control-plane-openai-observer",
  "main": "src/openai-consumer.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "MODEL_INVOCATION_REGISTRY",
        "class_name": "ModelInvocationRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "openai-observe-v1",
      "new_sqlite_classes": ["ModelInvocationRegistry"]
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "setpoint-leader-events",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
